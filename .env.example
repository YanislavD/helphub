# Copy this file to `.env.local` and fill in your own values (Supabase → Project Settings → API).
# `.env.local` is git-ignored – never commit real keys.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The service_role key is NOT listed here on purpose: it is only ever used inside
# Supabase Edge Functions (set via `supabase secrets set`), never in the frontend.
